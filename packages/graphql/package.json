{
  "name": "cormo-graphql",
  "version": "2.3.0",
  "description": "GraphQL support for CORMO",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/cjs/index.js",
  "types": "./lib/cjs/index.d.ts",
  "exports": {
    "import": "./lib/esm/index.js",
    "require": "./lib/cjs/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run lint && npm run build",
    "build": "rimraf lib && tsc -b src/tsconfig.build.cjs.json src/tsconfig.build.esm.json && echo '{\"type\":\"commonjs\"}' > lib/cjs/package.json",
    "lint": "../../node_modules/.bin/biome check .",
    "test:type": "tsc --noEmit",
    "test:unit": "NODE_ENV=test TZ=Etc/UTC vitest run",
    "test": "npm run test:type && npm run lint && npm run test:unit --",
    "test:debug": "NODE_ENV=test TZ=Etc/UTC vitest --inspect-brk --no-file-parallelism",
    "test:cov": "npm run test:type && npm run lint && NODE_ENV=test TZ=Etc/UTC vitest run --coverage",
    "changeset": "changeset",
    "release": "npm run lint && npm run build && npm run changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/croquiscom/cormo.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/croquiscom/cormo/issues"
  },
  "homepage": "https://github.com/croquiscom/cormo",
  "dependencies": {
    "@croquiscom/crary-graphql": "^1.6.0",
    "cormo": "^2.6.0",
    "graphql": "^16.13.2",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.14.1",
    "@types/sinon": "^21.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.20.0",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.3",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
